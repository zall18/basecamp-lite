datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  LEAD
  LOGISTICS
  CONSUMPTION
  STAGE_EVENT
  MEDIA_DOCS
  PUBLIC_RELATIONS
  VOLUNTEER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum ItemStatus {
  NOT_PICKED_UP
  ON_THE_WAY
  DELIVERED
  RETURNED
}

model Event {
  id          String          @id @default(uuid())
  slug        String          @unique
  title       String
  description String?
  isPublic    Boolean         @default(false)
  passcode    String?         // Akses privat instan (6 digit PIN)
  date        DateTime
  location    String?
  wifiSSID    String?
  wifiPass    String?
  members     EventMember[]
  tasks       Task[]
  logistics   LogisticsItem[]
  rundowns    RundownItem[]
  assets      QuickAsset[]
  sosAlerts   SosAlert[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model EventMember {
  id        String          @id @default(uuid())
  eventId   String
  name      String
  phone     String?         // Integrasi direct link WhatsApp
  role      RoleType        @default(VOLUNTEER)
  customTag String?
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tasks     Task[]
  logistics LogisticsItem[]
}

model Task {
  id          String       @id @default(uuid())
  eventId     String
  title       String
  assigneeId  String?
  status      TaskStatus   @default(TODO)
  deadline    DateTime?
  lastNudgeAt DateTime?
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee    EventMember? @relation(fields: [assigneeId], references: [id])
}

model LogisticsItem {
  id          String       @id @default(uuid())
  eventId     String
  name        String
  category    String       // e.g. "Konsumsi", "Elektronik", "Dekorasi"
  status      ItemStatus   @default(NOT_PICKED_UP)
  picId       String?
  vendorPhone String?
  photoProof  String?      // URL foto serah terima
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pic         EventMember? @relation(fields: [picId], references: [id])
}

model RundownItem {
  id          String    @id @default(uuid())
  eventId     String
  order       Int
  title       String
  speaker     String?
  startTime   DateTime
  endTime     DateTime
  cueNotes    String?
  isCurrent   Boolean   @default(false)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model QuickAsset {
  id          String    @id @default(uuid())
  eventId     String
  title       String
  url         String
  category    String    // e.g. "Drive", "Streaming", "Form", "Slides"
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model SosAlert {
  id          String    @id @default(uuid())
  eventId     String
  message     String
  senderName  String
  isResolved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
}
